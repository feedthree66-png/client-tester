rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: clients
    // Document ID: {clientId}
    // Fields:
    //   - id: string (required, 1..64 chars)
    //   - name: string (required, 1..120 chars)
    //   - brokerId: string (required, 1..80 chars)
    //   - accessCode: string (required, 1..64 chars)
    //   - status: string (required, 'active' or 'inactive')
    //   - createdAt: string (required, 1..40 chars)
    //   - updatedAt: number (optional)
    //
    // ===============================================================

    function isValidClientAccount(data) {
      return data.keys().hasAll(['id', 'name', 'brokerId', 'accessCode', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'name', 'brokerId', 'accessCode', 'status', 'createdAt', 'updatedAt']) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 64 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
             data.brokerId is string && data.brokerId.size() >= 1 && data.brokerId.size() <= 80 &&
             data.accessCode is string && data.accessCode.size() >= 1 && data.accessCode.size() <= 64 &&
             data.status in ['active', 'inactive'] &&
             data.createdAt is string && data.createdAt.size() >= 1 && data.createdAt.size() <= 40 &&
             (!('updatedAt' in data) || data.updatedAt is number);
    }

    match /clients/{clientId} {
      allow read: if true;
      allow create, update: if isValidClientAccount(request.resource.data) && request.resource.data.id == clientId;
      allow delete: if clientId.size() >= 1 && clientId.size() <= 64;
    }

    match /system/{docId} {
      allow read: if true;
      allow create, update: if docId == 'meta' &&
                            request.resource.data.keys().hasOnly(['seeded', 'updatedAt']) &&
                            request.resource.data.seeded is bool &&
                            request.resource.data.updatedAt is number;
    }
  }
}
